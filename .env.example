# CaseScreenChecker Environment Variables
PORT=3000
NODE_ENV=production

# Database Configuration (Optional - If using PostgreSQL or Supabase on VPS)
# DATABASE_URL=postgresql://user:password@localhost:5432/casescreenchecker

# Demo / Research feature flag - disabled by default for retail use.
# When false, the "Research" tab and simulated data are hidden.
VITE_ENABLE_DEMO_RESEARCH=false
